// Cloudflare: serve the built static site (site/) from a Worker with static assets.
// Build first with `python build.py`; Cloudflare's Git integration runs the build for you (see README).
{
  "$schema": "https://unpkg.com/wrangler@4.160.0/config-schema.json",
  "name": "persian-gulf-daily-summary",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
