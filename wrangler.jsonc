// Cloudflare: serve the built static site (site/) from a Worker with static assets.
// `wrangler deploy` (and `wrangler dev`) run build.py first, so no separate build step is needed.
{
  "$schema": "https://unpkg.com/wrangler@4.160.0/config-schema.json",
  "name": "claude",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "python3 build.py"
  },
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
